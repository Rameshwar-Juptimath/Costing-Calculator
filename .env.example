# =============================================================================
# Manufacturing Costing Engine — Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=costing_user
POSTGRES_PASSWORD=costing_pass_123
POSTGRES_DB=costing_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full DSN used by FastAPI (async driver)
DATABASE_URL=postgresql+asyncpg://costing_user:costing_pass_123@db:5432/costing_db
# Alembic uses sync driver (psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://costing_user:costing_pass_123@db:5432/costing_db

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_64_char_hex_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=/app/uploads

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Admin Provisioning ---
# First admin user created by seed script (Basic tier)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123!

# Second admin user created by seed script (Pro tier)
PRO_ADMIN_EMAIL=pro_admin@example.com
PRO_ADMIN_PASSWORD=ProAdmin@123!

# --- Frontend (Next.js) ---
# Public — baked into client bundle at build time
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only — used by Next.js server to talk to FastAPI inside Docker network
FASTAPI_URL=http://backend:8000

# JWT secret (must match backend)
JWT_SECRET=replace_with_64_char_hex_secret
